      "organization": "NOI S.p.A",
      "organizationUrl": "https://noi.bz.it"
    }
  ],
  "authors": [
    {
      "name": "Elisa Ciardulli",
      "email": "ciardulli.elisa@gmail.com",
      "organization": "Open Data Hub",
      "organizationUrl": "https://opendatahub.com"
    }
  ],
  "image": "wcs-logo.png",
  "searchTags": ["lifecycle", "badge", "opendatahub", "beta", "deprecated"],
  "dist": {
    "basePath": "dist",
    "files": [
      "webcomp-opendatahub-lifecycle-badge.min.js"
    ],
    "scripts": [
    ]
  },
  "configuration": {
    "tagName": "opendatahub-lifecycle-badge",
    "options": [
      {
        "key": "lifecycle",
        "type": "text",
        "label": "lifecycle mode (RnD or deprecated)",
        "required": true,
        "options": {
          "default": "RnD"
        }
      }
    ]
  }
}
