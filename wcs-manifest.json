{
  "title": "Open Data Hub Lifecycle Badge",
  "shortName": "open-data-hub-lifecycle-badge",
  "description": "Badge showing the lifecycle status (R&D or deprecated) of an Open Data Hub tool",
  "descriptionAbstract": "Web component that displays a badge for certain lifecycle stages (R&D or deprecated) of Open Data Hub tools. The mode is set via an HTML attribute, and clicking the badge opens the lifecycle documentation",
